# Application Settings
APP_NAME=Sherify Campaign Manager
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sherify
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sherify_test

# Redis Infrastructure (Prepared for V3 queue)
REDIS_URL=redis://localhost:6379/0

# Security / JWT (Foundational configuration)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
