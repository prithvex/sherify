# General App Settings
APP_NAME="Sherify Campaign Manager"
APP_ENV="development"
DEBUG=true
PUBLIC_API_BASE_URL="http://localhost:8000"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/sherify"
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/sherify_test"

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CAMPAIGN_BATCH_SIZE=100

# Bulk CSV Import Configuration
MAX_IMPORT_FILE_SIZE_MB=15
IMPORT_BATCH_SIZE=500
STORAGE_LOCAL_DIR="uploads/imports"

# Email Provider Configuration
EMAIL_PROVIDER="mock"

# Webhook Configuration
WEBHOOK_SIGNING_SECRET="dev-webhook-signing-secret"

# Security & JWT Foundation
JWT_SECRET_KEY="dev-insecure-secret-key-replace-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
