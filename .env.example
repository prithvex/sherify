# General Application Settings
APP_NAME=Sherify Campaign Manager
APP_ENV=development
DEBUG=True
PUBLIC_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sherify
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sherify_test

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CAMPAIGN_BATCH_SIZE=100

# Bulk CSV Import Configuration
MAX_IMPORT_FILE_SIZE_MB=15
IMPORT_BATCH_SIZE=500
STORAGE_LOCAL_DIR=uploads/imports

# Email Provider Configuration (options: "mock", "smtp", "ses", "sendgrid", "resend")
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_TIMEOUT_SECONDS=15
EMAIL_RATE_LIMIT_PER_SECOND=50
MAX_RECIPIENT_RETRIES=3

# Default Sender Identity
EMAIL_FROM_ADDRESS=campaigns@sherify.internal
EMAIL_FROM_NAME=Sherify Campaigns
EMAIL_REPLY_TO=support@sherify.internal

# SMTP Provider Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Webhooks Signing Secret (for inbound provider webhooks)
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret

# JWT Authentication
JWT_SECRET_KEY=dev-insecure-secret-key-replace-in-production-with-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
